# Окружение запуска: local | production
SSN_ENVIRONMENT=local

# Секрет для подписи JWT. В проде заменить на длинную случайную строку.
SSN_SECRET_KEY=change-me-in-production

# Подключение к PostgreSQL (async-драйвер asyncpg)
SSN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillshare

# Redis (кэш/брокер) — задел на следующий спринт
SSN_REDIS_URL=redis://localhost:6379/0

# Внешний базовый URL приложения (для абсолютных ссылок). Можно оставить пустым.
# SSN_PUBLIC_BASE_URL=https://skillshare.example.com
